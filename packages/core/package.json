{
  "name": "@ope/core",
  "version": "0.1.0",
  "description": "El núcleo de una aplicación de OPE-Web: registro de pantallas, navegación tipada, acciones y estados.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./build": {
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "checks",
    "build",
    "docs"
  ],
  "peerDependencies": {
    "@ope/session": "^0.1.0",
    "@granito/ui": "^0.2.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-router": "^7.0.0",
    "vite": "^8.0.0"
  },
  "bin": {
    "ope-check": "./checks/cli.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node prepack.mjs",
    "prepack": "node prepack.mjs"
  },
  "ope": {
    "generated": [
      "dist",
      "docs"
    ]
  },
  "license": "UNLICENSED"
}
