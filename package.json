{
  "name": "cuarzo",
  "version": "0.0.0",
  "description": "La aplicación base de la que se clona cada frontend de Tandilia.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "avance": "node tests/progress.mjs",
    "build": "npm run build:paquetes && tsc -b && vite build",
    "build:paquetes": "npm run build -w @cuarzo/core -w @cuarzo/session",
    "catalogo": "node tests/catalogo.mjs",
    "clon": "node tests/clone.mjs",
    "dev": "npm run build:paquetes && vite",
    "iconos": "node tests/icons.mjs",
    "nueva-aplicacion": "node tests/clone.mjs",
    "revisar": "biome check .",
    "simulado": "node tests/mock.mjs",
    "simulado:contrato": "prism mock contracts/demo.yaml --port 4010 --errors",
    "test": "npm run build:paquetes && cuarzo-check && node tests/roles.mjs --verificar && node tests/constraints.mjs --verificar && node tests/catalogo.mjs --verificar && node tests/icons.mjs && npm --prefix packages/session test && vitest run && node tests/clone.mjs",
    "tipos": "npx -y openapi-typescript contracts/demo.yaml -o src/api/demo/types.ts && node tests/roles.mjs && node tests/constraints.mjs",
    "vitest": "vitest run"
  },
  "dependencies": {
    "@granito/tokens": "file:../granito/packages/tokens",
    "@granito/ui": "file:../granito/packages/ui",
    "@tanstack/react-query": "^5.101.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@stoplight/prism-cli": "^5.14.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "cuarzo": {
    "compositionLayer": [
      "src/app/main.tsx",
      "src/app/dev-session.ts",
      "packages/core/src/app/bootstrap.tsx",
      "packages/core/src/app/create-application.tsx"
    ]
  }
}
